DARWIN_INSTALL_COMMAND="brew install --quiet"
DEBIAN_INSTALL_COMMAND="apt-get update && apt-get install -y --no-install-recommends"
DARWIN_BUILD_DEPS="ansible ansible-lint yamllint check-jsonschema jq bats-core shellcheck checkmake xmlstarlet kcov"
DEBIAN_BUILD_DEPS="ansible ansible-lint yamllint jq bats shellcheck pipx curl ca-certificates make git xmlstarlet kcov"
DEBIAN_PIPX_DEPS="check-jsonschema"
CHECKMAKE_VERSION="v0.3.2"
DEBIAN_TAG="trixie-slim"
COLLECTION_NAMESPACE="thruput"
COLLECTION_NAME="local_runtime"
